{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "blocked_reason", "summary", "decisions", "suspected_bugs"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"]
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "maxLength": 600,
      "description": "Why the run could not be done; null when status is completed."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "1-3 sentences on what was done and why; no test counts, suite results or coverage numbers."
    },
    "decisions": {
      "type": "array",
      "description": "One entry per assessed source file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "action", "reason", "test_files"],
        "properties": {
          "file": {
            "type": "string",
            "description": "Repo-relative source path, e.g. backend/src/features/todos/router.ts."
          },
          "action": {
            "type": "string",
            "enum": ["create", "update", "skip"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "One or two sentences."
          },
          "test_files": {
            "type": "array",
            "description": "Repo-relative test files that exercise this source file after the run.",
            "items": { "type": "string" }
          }
        }
      }
    },
    "suspected_bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "description"],
        "properties": {
          "file": { "type": "string" },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "Expected versus actual behaviour, and the failing test if any."
          }
        }
      }
    }
  }
}
